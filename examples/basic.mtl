// МТС v0.2 — canonical formal notation
// Normative theory/contracts: netkeep80/anum_docs

∞ : {◁ = ∞, ▷ = ∞}
() : ♀() ⟼ ()♂
([) : (♀∞)
(]) : (∞♂)
(⟼) : (♀∞ ⟼ ∞♂)
(↛) : (∞♂ ⟼ ♀∞)
[1] : (⟼)
[0] : (↛)
(=) : {♀◁ = ♀▷, ◁♂ = ▷♂}
(!=) : ¬(=)

// Structural examples. `[]` occurrences are independent unless interpretation
// explicitly aliases/binds them; round grouping is syntax-preserving.
10 = [] ⟼ []
20 = ([] ⟼ []) ⟼ []

// Context pronouns are atomic and ancestor ascent is a separate operator.
◁ = ◁
↑◁ = ↑◁
a ⟼ b = a ⟼ b
